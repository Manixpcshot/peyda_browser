<UserControl
    x:Class="PeydaBrowser.App.Pages.BookmarksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="28" ColumnSpacing="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="{Binding Strings.BookmarksTitle}" Style="{ThemeResource TitleTextBlockStyle}" />
            <ListView x:Name="FolderList" Grid.Row="1" ItemsSource="{Binding Folders}" SelectionChanged="OnFolderSelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8" Padding="2">
                            <FontIcon Glyph="&#xE8B7;" FontSize="13" />
                            <TextBlock Text="{Binding Name}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Grid.Row="2" Spacing="6">
                <Button HorizontalAlignment="Stretch" Click="OnAddFolderClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                        <TextBlock Text="{Binding Strings.BookmarksAddFolder}" />
                    </StackPanel>
                </Button>
                <Button HorizontalAlignment="Stretch" Click="OnDeleteFolderClick">
                    <TextBlock Text="{Binding Strings.CommonDelete}" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Click="OnImportClick"><TextBlock Text="{Binding Strings.BookmarksImport}" /></Button>
                <Button Click="OnExportClick"><TextBlock Text="{Binding Strings.BookmarksExport}" /></Button>
            </StackPanel>
            <TextBox Grid.Row="1" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="{Binding Strings.CommonSearch}" />
            <Grid Grid.Row="2">
                <TextBlock Text="{Binding Strings.BookmarksEmpty}" Opacity="0.7" TextWrapping="WrapWholeWords"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                <ListView ItemsSource="{Binding Items}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnBookmarkClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="4" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image Source="{Binding FaviconUrl}" Width="16" Height="16" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Url}" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.7"
                                               FlowDirection="LeftToRight" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="2" Tag="{Binding}" Click="OnEditBookmarkClick" Background="Transparent" BorderThickness="0">
                                    <FontIcon Glyph="&#xE70F;" FontSize="12" />
                                </Button>
                                <Button Grid.Column="3" Tag="{Binding}" Click="OnDeleteBookmarkClick" Background="Transparent" BorderThickness="0">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
