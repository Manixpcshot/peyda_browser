<Application
    x:Class="PeydaBrowser.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:PeydaBrowser.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Index 1 is reserved for the runtime theme dictionary
                     installed by ThemeService (Peyda brushes/sizes). -->
                <ResourceDictionary />
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
            <converters:InverseBoolConverter x:Key="InverseBool" />
            <converters:NullToVisibilityConverter x:Key="NullToVisibility" />
            <converters:NullToVisibilityConverter x:Key="NotNullToVisibility" Invert="True" />
            <converters:DateTimeTextConverter x:Key="DateTimeText" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
