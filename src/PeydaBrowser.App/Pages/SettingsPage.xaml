<UserControl
    x:Class="PeydaBrowser.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="28" Spacing="26" MaxWidth="900" HorizontalAlignment="Stretch">
            <TextBlock Text="{Binding Strings.SettingsTitle}" Style="{ThemeResource TitleLargeTextBlockStyle}" />

            <!-- General -->
            <StackPanel Spacing="10">
                <TextBlock Text="{Binding Strings.SettingsGeneral}" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <ComboBox x:Name="StartupCombo" Header="{Binding Strings.SettingsStartupBehavior}" HorizontalAlignment="Stretch"
                          SelectedIndex="{Binding StartupIndex, Mode=TwoWay}" SelectionChanged="OnSettingChanged" />
                <TextBox Header="{Binding Strings.SettingsHomePage}" Text="{Binding HomePage, Mode=TwoWay}"
                         FlowDirection="LeftToRight" LostFocus="OnSettingLostFocus" />
                <ComboBox x:Name="LanguageCombo" Header="{Binding Strings.SettingsLanguage}" HorizontalAlignment="Stretch"
                          SelectedIndex="{Binding LanguageIndex, Mode=TwoWay}" SelectionChanged="OnSettingChanged" />
            </StackPanel>

            <!-- Search engines -->
            <StackPanel x:Name="SearchSection" Spacing="10">
                <TextBlock Text="{Binding Strings.SettingsSearchSection}" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <ComboBox Header="{Binding Strings.SettingsDefaultEngine}" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding Engines}" DisplayMemberPath="Name"
                          SelectedItem="{Binding DefaultEngine, Mode=TwoWay}" />
                <ListView ItemsSource="{Binding Engines}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="8" Padding="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{Binding UrlTemplate}" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.7"
                                               FlowDirection="LeftToRight" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="1" Tag="{Binding}" Click="OnEngineMoveUp" Background="Transparent" BorderThickness="0">
                                    <FontIcon Glyph="&#xE70E;" FontSize="11" />
                                </Button>
                                <Button Grid.Column="2" Tag="{Binding}" Click="OnEngineMoveDown" Background="Transparent" BorderThickness="0">
                                    <FontIcon Glyph="&#xE70D;" FontSize="11" />
                                </Button>
                                <Button Grid.Column="3" Tag="{Binding}" Click="OnEngineDelete" Background="Transparent" BorderThickness="0">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Header="{Binding Strings.SettingsEngineName}" Text="{Binding NewEngineName, Mode=TwoWay}" />
                    <TextBox Grid.Column="1" Header="{Binding Strings.SettingsEngineTemplate}" Text="{Binding NewEngineTemplate, Mode=TwoWay}" FlowDirection="LeftToRight" />
                    <TextBox Grid.Column="2" Header="{Binding Strings.SettingsEngineBang}" Text="{Binding NewEngineBang, Mode=TwoWay}" FlowDirection="LeftToRight" />
                    <Button Grid.Column="3" VerticalAlignment="Bottom" Command="{Binding AddEngineCommand}">
                        <TextBlock Text="{Binding Strings.SettingsAddEngine}" />
                    </Button>
                </Grid>
                <TextBlock Text="{Binding EngineError}" Foreground="IndianRed" TextWrapping="WrapWholeWords" />
            </StackPanel>

            <!-- Appearance -->
            <StackPanel Spacing="10">
                <TextBlock Text="{Binding Strings.SettingsAppearance}" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <ComboBox x:Name="ThemeModeCombo" Header="{Binding Strings.SettingsThemeMode}" HorizontalAlignment="Stretch"
                          SelectedIndex="{Binding ThemeModeIndex, Mode=TwoWay}" SelectionChanged="OnSettingChanged" />
                <ComboBox Header="{Binding Strings.SettingsTheme}" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding Themes}" DisplayMemberPath="Definition.Name"
                          SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Click="OnImportThemeClick"><TextBlock Text="{Binding Strings.SettingsThemeImport}" /></Button>
                    <Button Click="OnExportThemeClick"><TextBlock Text="{Binding Strings.SettingsThemeExport}" /></Button>
                    <Button Command="{Binding DeleteSelectedThemeCommand}">
                        <TextBlock Text="{Binding Strings.CommonDelete}" />
                    </Button>
                </StackPanel>
                <TextBlock Text="{Binding ThemeStatus}" Opacity="0.8" TextWrapping="WrapWholeWords" />
                <ComboBox x:Name="DensityCombo" Header="{Binding Strings.SettingsDensity}" HorizontalAlignment="Stretch"
                          SelectedIndex="{Binding DensityIndex, Mode=TwoWay}" SelectionChanged="OnSettingChanged" />
                <ToggleSwitch Header="{Binding Strings.SettingsShowBookmarkBar}" IsOn="{Binding ShowBookmarkBar, Mode=TwoWay}" Toggled="OnToggleChanged" />
                <ToggleSwitch Header="{Binding Strings.SettingsShowSidebarButtons}" IsOn="{Binding ShowSidebar, Mode=TwoWay}" Toggled="OnToggleChanged" />
                <TextBlock Text="{Binding Strings.SettingsVerticalTabsNote}" Opacity="0.7" TextWrapping="WrapWholeWords" />
            </StackPanel>

            <!-- Downloads -->
            <StackPanel Spacing="10">
                <TextBlock Text="{Binding Strings.SettingsDownloadsSection}" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Header="{Binding Strings.SettingsDownloadFolder}" Text="{Binding DownloadFolder, Mode=TwoWay}"
                             FlowDirection="LeftToRight" LostFocus="OnSettingLostFocus" />
                    <Button Grid.Column="1" VerticalAlignment="Bottom" Click="OnBrowseDownloadFolder">
                        <TextBlock Text="{Binding Strings.SettingsBrowse}" />
                    </Button>
                </Grid>
                <ToggleSwitch Header="{Binding Strings.SettingsAskWhereToSave}" IsOn="{Binding AskWhereToSave, Mode=TwoWay}" Toggled="OnToggleChanged" />
            </StackPanel>

            <!-- Privacy & security -->
            <StackPanel Spacing="10">
                <TextBlock Text="{Binding Strings.SettingsPrivacy}" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <ToggleSwitch Header="{Binding Strings.SettingsRecordHistory}" IsOn="{Binding RecordHistory, Mode=TwoWay}" Toggled="OnToggleChanged" />
                <ToggleSwitch Header="{Binding Strings.SettingsBlockPopups}" IsOn="{Binding BlockPopups, Mode=TwoWay}" Toggled="OnToggleChanged" />
                <ToggleSwitch Header="{Binding Strings.SettingsDevTools}" IsOn="{Binding DevToolsEnabled, Mode=TwoWay}" Toggled="OnToggleChanged" />
                <ToggleSwitch Header="{Binding Strings.SettingsTelemetry}" IsOn="{Binding TelemetryEnabled, Mode=TwoWay}" Toggled="OnToggleChanged" />
                <TextBlock Text="{Binding Strings.SettingsTelemetryNote}" Opacity="0.7" TextWrapping="WrapWholeWords" />
                <ToggleSwitch Header="{Binding Strings.SettingsCheckUpdates}" IsOn="{Binding CheckUpdates, Mode=TwoWay}" Toggled="OnToggleChanged" />
                <ComboBox x:Name="ChannelCombo" Header="{Binding Strings.SettingsUpdateChannel}" HorizontalAlignment="Stretch"
                          SelectedIndex="{Binding UpdateChannelIndex, Mode=TwoWay}" SelectionChanged="OnSettingChanged" />
                <Button Click="OnClearDataClick" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Strings.ClearTitle}" />
                </Button>
                <TextBlock x:Name="ClearStatus" Opacity="0.8" />

                <TextBlock Text="{Binding Strings.SettingsPermissions}" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
                <ListView ItemsSource="{Binding Permissions}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="10" Padding="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Origin}" FlowDirection="LeftToRight" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{Binding Kind}" />
                                <TextBlock Grid.Column="2" Text="{Binding Decision}" />
                                <Button Grid.Column="3" Tag="{Binding}" Click="OnPermissionDelete" Background="Transparent" BorderThickness="0">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <!-- New Tab page -->
            <StackPanel Spacing="10">
                <TextBlock Text="{Binding Strings.SettingsNewTabSection}" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <ToggleSwitch Header="{Binding Strings.SettingsNewtabShowClock}" IsOn="{Binding NtShowClock, Mode=TwoWay}" Toggled="OnToggleChanged" />
                <ToggleSwitch Header="{Binding Strings.SettingsNewtabShowDate}" IsOn="{Binding NtShowDate, Mode=TwoWay}" Toggled="OnToggleChanged" />
                <ToggleSwitch Header="{Binding Strings.SettingsNewtabShowLogo}" IsOn="{Binding NtShowLogo, Mode=TwoWay}" Toggled="OnToggleChanged" />
                <ToggleSwitch Header="{Binding Strings.SettingsNewtabShowShortcuts}" IsOn="{Binding NtShowShortcuts, Mode=TwoWay}" Toggled="OnToggleChanged" />
                <ToggleSwitch Header="{Binding Strings.SettingsNewtabShowGreeting}" IsOn="{Binding NtShowGreeting, Mode=TwoWay}" Toggled="OnToggleChanged" />
                <TextBox Header="{Binding Strings.SettingsNewtabGreetingName}" Text="{Binding NtGreetingName, Mode=TwoWay}" LostFocus="OnSettingLostFocus" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Header="{Binding Strings.SettingsNewtabBackgroundImage}" Text="{Binding NtBackgroundImage, Mode=TwoWay}"
                             FlowDirection="LeftToRight" LostFocus="OnSettingLostFocus" />
                    <Button Grid.Column="1" VerticalAlignment="Bottom" Click="OnChooseBackgroundImage">
                        <TextBlock Text="{Binding Strings.SettingsNewtabChooseImage}" />
                    </Button>
                    <Button Grid.Column="2" VerticalAlignment="Bottom" Click="OnClearBackgroundImage">
                        <TextBlock Text="{Binding Strings.SettingsNewtabClearImage}" />
                    </Button>
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
