<UserControl
    x:Class="PeydaBrowser.App.Pages.InternalErrorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520" Spacing="14" Padding="24">
            <FontIcon Glyph="&#xE7BA;" FontSize="52" HorizontalAlignment="Center" Foreground="{ThemeResource PeydaAccentBrush}" />
            <TextBlock Text="{Binding ErrorTitle}" Style="{ThemeResource TitleTextBlockStyle}" HorizontalAlignment="Center" TextAlignment="Center" />
            <TextBlock Text="{Binding ErrorMessage}" Style="{ThemeResource BodyTextBlockStyle}"
                       TextWrapping="WrapWholeWords" TextAlignment="Center" Opacity="0.85" />
        </StackPanel>
    </Grid>
</UserControl>
