<UserControl
    x:Class="PeydaBrowser.App.Controls.BrowserTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid x:Name="WebHost" />
        <ContentControl x:Name="InternalHost"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Visibility="Collapsed" />
        <Grid x:Name="ErrorHost" Visibility="Collapsed" Background="{ThemeResource PeydaSurfaceBrush}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520" Spacing="14" Padding="24">
                <FontIcon Glyph="&#xE7BA;" FontSize="52" HorizontalAlignment="Center" Foreground="{ThemeResource PeydaAccentBrush}" />
                <TextBlock x:Name="ErrorTitle" Style="{ThemeResource TitleTextBlockStyle}" TextAlignment="Center" TextWrapping="WrapWholeWords" />
                <TextBlock x:Name="ErrorMessage" Style="{ThemeResource BodyTextBlockStyle}" TextAlignment="Center" TextWrapping="WrapWholeWords"
                           Foreground="{ThemeResource PeydaTextSecondaryBrush}" />
                <Button x:Name="ErrorReloadButton" HorizontalAlignment="Center" Style="{ThemeResource AccentButtonStyle}" Click="OnErrorReloadClick" />
            </StackPanel>
        </Grid>
        <ProgressBar x:Name="LoadingBar" VerticalAlignment="Top" IsIndeterminate="True" Visibility="Collapsed" />
    </Grid>
</UserControl>
