<UserControl
    x:Class="PeydaBrowser.App.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="28" Spacing="14" MaxWidth="720" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image Source="ms-appx:///Assets/Logo.png" Width="96" Height="96" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding Strings.AppName}" Style="{ThemeResource TitleLargeTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding Strings.AppTagline}" Style="{ThemeResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" Opacity="0.8" />
            <TextBlock Text="{Binding Strings.AboutDescription}" Style="{ThemeResource BodyTextBlockStyle}" TextWrapping="WrapWholeWords" TextAlignment="Center" />
            <StackPanel Spacing="4" HorizontalAlignment="Center">
                <TextBlock Text="{Binding VersionText}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding WebView2Text}" HorizontalAlignment="Center" Opacity="0.8" />
                <TextBlock Text="{Binding Strings.AboutUnsigned}" HorizontalAlignment="Center" Opacity="0.7"
                           TextWrapping="WrapWholeWords" TextAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,8,0,0">
                <Button Style="{ThemeResource AccentButtonStyle}" Command="{Binding CheckUpdatesCommand}">
                    <TextBlock Text="{Binding Strings.SettingsUpdateChannel}" />
                </Button>
                <Button Command="{Binding OpenReleasePageCommand}" Visibility="{Binding HasUpdateRelease, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding Strings.UpdateOpenRelease}" />
                </Button>
                <Button Click="OnOpenRepositoryClick">
                    <TextBlock Text="GitHub" />
                </Button>
            </StackPanel>
            <TextBlock Text="{Binding UpdateStatus}" HorizontalAlignment="Center" TextWrapping="WrapWholeWords" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
