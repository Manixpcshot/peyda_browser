<UserControl
    x:Class="PeydaBrowser.App.Controls.BrowserToolbar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

    <Grid x:Name="ToolbarRoot" Background="{ThemeResource PeydaToolbarBrush}" Padding="6,4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
            <Button x:Name="BackButton" Click="OnBackClick" Background="Transparent" BorderThickness="0">
                <FontIcon Glyph="&#xE72B;" FontSize="14" />
            </Button>
            <Button x:Name="ForwardButton" Click="OnForwardClick" Background="Transparent" BorderThickness="0">
                <FontIcon Glyph="&#xE72A;" FontSize="14" />
            </Button>
            <Button x:Name="ReloadButton" Click="OnReloadClick" Background="Transparent" BorderThickness="0">
                <FontIcon Glyph="&#xE72C;" FontSize="14" />
            </Button>
            <Button x:Name="StopButton" Click="OnStopClick" Background="Transparent" BorderThickness="0" Visibility="Collapsed">
                <FontIcon Glyph="&#xE711;" FontSize="14" />
            </Button>
            <Button x:Name="HomeButton" Click="OnHomeClick" Background="Transparent" BorderThickness="0">
                <FontIcon Glyph="&#xE80F;" FontSize="14" />
            </Button>
        </StackPanel>

        <Grid Grid.Column="1" Margin="6,0" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="SecurityButton" Grid.Column="0" Background="Transparent" BorderThickness="0" Click="OnSecurityClick">
                <FontIcon x:Name="SecurityIcon" Glyph="&#xE946;" FontSize="13" />
                <Button.Flyout>
                    <Flyout>
                        <StackPanel Spacing="6" MaxWidth="320">
                            <TextBlock x:Name="SecurityTitle" Style="{ThemeResource SubtitleTextBlockStyle}" TextWrapping="WrapWholeWords" />
                            <TextBlock x:Name="SecurityDetails" Style="{ThemeResource BodyTextBlockStyle}" TextWrapping="WrapWholeWords" FlowDirection="LeftToRight" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <AutoSuggestBox x:Name="AddressBox" Grid.Column="1"
                            FlowDirection="LeftToRight"
                            QuerySubmitted="OnAddressQuerySubmitted"
                            SuggestionChosen="OnAddressSuggestionChosen"
                            TextChanged="OnAddressTextChanged">
                <AutoSuggestBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,4" FlowDirection="LeftToRight">
                            <TextBlock Text="{Binding DisplayText}" Style="{ThemeResource BodyTextBlockStyle}" />
                            <TextBlock Text="{Binding Url}" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.7" />
                        </StackPanel>
                    </DataTemplate>
                </AutoSuggestBox.ItemTemplate>
            </AutoSuggestBox>

            <Button x:Name="EngineButton" Grid.Column="2" Background="Transparent" BorderThickness="0">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon Glyph="&#xE721;" FontSize="13" />
                    <FontIcon Glyph="&#xE70D;" FontSize="10" />
                </StackPanel>
                <Button.Flyout>
                    <MenuFlyout x:Name="EngineFlyout" Opening="OnEngineFlyoutOpening" />
                </Button.Flyout>
            </Button>

            <Button x:Name="BookmarkButton" Grid.Column="3" Background="Transparent" BorderThickness="0" Click="OnBookmarkClick">
                <FontIcon x:Name="BookmarkIcon" Glyph="&#xE734;" FontSize="14" />
            </Button>
        </Grid>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
            <Border x:Name="PrivateBadge" Visibility="Collapsed" CornerRadius="10" Padding="8,2" Margin="4,0"
                    Background="{ThemeResource PeydaAccentBrush}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon Glyph="&#xE72E;" FontSize="11" Foreground="White" />
                    <TextBlock x:Name="PrivateBadgeText" Foreground="White" FontSize="11" />
                </StackPanel>
            </Border>
            <Button x:Name="HistoryButton" Background="Transparent" BorderThickness="0" Click="OnHistoryClick">
                <FontIcon Glyph="&#xE81C;" FontSize="14" />
            </Button>
            <Button x:Name="DownloadsButton" Background="Transparent" BorderThickness="0" Click="OnDownloadsClick">
                <FontIcon Glyph="&#xE896;" FontSize="14" />
            </Button>
            <Button x:Name="NewTabButton" Background="Transparent" BorderThickness="0" Click="OnNewTabClick">
                <FontIcon Glyph="&#xE710;" FontSize="14" />
            </Button>
            <Button x:Name="MenuButton" Background="Transparent" BorderThickness="0">
                <FontIcon Glyph="&#xE712;" FontSize="14" />
                <Button.Flyout>
                    <MenuFlyout x:Name="MainMenu" Opening="OnMainMenuOpening" />
                </Button.Flyout>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
