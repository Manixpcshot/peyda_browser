<UserControl
    x:Class="PeydaBrowser.App.Pages.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="28" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Strings.DownloadsTitle}" Style="{ThemeResource TitleTextBlockStyle}" />
            <Button Grid.Column="1" Command="{Binding ClearCompletedCommand}">
                <TextBlock Text="{Binding Strings.DownloadsClearCompleted}" />
            </Button>
        </Grid>
        <Grid Grid.Row="1">
            <TextBlock Text="{Binding Strings.DownloadsEmpty}" Opacity="0.7"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
            <ListView ItemsSource="{Binding Items}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="6" RowSpacing="4" ColumnSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE7BA;" FontSize="13" VerticalAlignment="Center"
                                          Visibility="{Binding IsDangerous, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding FileName}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding StateText}" Opacity="0.7" VerticalAlignment="Center" />
                            </StackPanel>

                            <ProgressBar Grid.Row="1" Grid.Column="0" Minimum="0" Maximum="100"
                                         Value="{Binding ProgressPercent}"
                                         IsIndeterminate="{Binding HasDeterminateProgress, Converter={StaticResource InverseBool}}"
                                         Visibility="{Binding IsLive, Converter={StaticResource BoolToVisibility}}" />

                            <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="{Binding SizeText}" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.7" />
                                <TextBlock Text="{Binding SpeedText}" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.7" />
                                <TextBlock Text="{Binding SourceUrl}" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.55"
                                           FlowDirection="LeftToRight" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                <Button Command="{Binding PauseCommand}" Visibility="{Binding CanPause, Converter={StaticResource BoolToVisibility}}"
                                        Background="Transparent" BorderThickness="0">
                                    <FontIcon Glyph="&#xE769;" FontSize="13" />
                                </Button>
                                <Button Command="{Binding ResumeCommand}" Visibility="{Binding CanResume, Converter={StaticResource BoolToVisibility}}"
                                        Background="Transparent" BorderThickness="0">
                                    <FontIcon Glyph="&#xE768;" FontSize="13" />
                                </Button>
                                <Button Command="{Binding CancelCommand}" Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}"
                                        Background="Transparent" BorderThickness="0">
                                    <FontIcon Glyph="&#xE711;" FontSize="13" />
                                </Button>
                                <Button Command="{Binding OpenFileCommand}" Background="Transparent" BorderThickness="0">
                                    <FontIcon Glyph="&#xE8E5;" FontSize="13" />
                                </Button>
                                <Button Command="{Binding OpenFolderCommand}" Background="Transparent" BorderThickness="0">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="13" />
                                </Button>
                                <Button Command="{Binding RemoveCommand}" Background="Transparent" BorderThickness="0">
                                    <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</UserControl>
