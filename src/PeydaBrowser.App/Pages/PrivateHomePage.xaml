<UserControl
    x:Class="PeydaBrowser.App.Pages.PrivateHomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560" Spacing="16" Padding="24">
            <FontIcon Glyph="&#xE72E;" FontSize="56" HorizontalAlignment="Center" Foreground="{ThemeResource PeydaAccentBrush}" />
            <TextBlock Text="{Binding Strings.PrivateHeading}" Style="{ThemeResource TitleTextBlockStyle}" HorizontalAlignment="Center" TextAlignment="Center" />
            <TextBlock Text="{Binding Strings.PrivateDescription}" Style="{ThemeResource BodyTextBlockStyle}"
                       TextWrapping="WrapWholeWords" TextAlignment="Center" Opacity="0.85" />
        </StackPanel>
    </Grid>
</UserControl>
